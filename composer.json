{
	"name": "software-by-design/nextcloud-carecheck",
	"description": "Mobile care documentation — tours, visit bundles, tamper-evident journal",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"require": {
		"php": ">=8.2",
		"dompdf/dompdf": "^3.0"
	},
	"require-dev": {
		"nextcloud/ocp": "^32.0 || ^33.0",
		"phpunit/phpunit": "^9.6"
	},
	"autoload": { "psr-4": { "OCA\\CareCheck\\": "lib/" } },
	"autoload-dev": {
		"psr-4": {
			"OCA\\CareCheck\\Tests\\": "tests/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/"
		}
	},
	"scripts": { "test": "phpunit --testsuite unit" },
	"config": { "optimize-autoloader": true, "sort-packages": true }
}
